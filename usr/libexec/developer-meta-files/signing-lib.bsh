#!/bin/bash

## Copyright (C) 2012 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Sourceable release signing + verification helpers.
##
## Callers set these (help-steps/variables already resolves them):
##   DEBEMAIL              OpenPGP signer email
##   signify_public_key    signify public key path (verify)
##   signify_private_key   signify secret key path (sign)
## and provide 'safe-rm', 'sq', 'signify-openbsd' on PATH.
##
## Scheme:
##   - OpenPGP ('.asc') authenticates EVERY published file. 'sq' streams, so
##     there is no file-size limit.
##   - signify ('.sig') authenticates every SMALL artifact, but NEVER a huge
##     disk image: signify reads the whole file into RAM and OOMs on a multi-
##     hundred-MB image. The image is authenticated transitively by its signed
##     '.sha512sums'. The OpenPGP-only 'sign_and_verify' is the safe DEFAULT;
##     callers add signify explicitly via 'sign_and_verify_signify' for a file
##     known to be small.

## style-ok: no-strict -- a sourced library.

sign_cmd_openpgp() {
   local base_name
   base_name="$(basename -- "$1")"
   test -f "$1"
   test -n "${DEBEMAIL:-}"
   safe-rm -f -- "$2"
   ## OpenPGP signatures do not authenticate filenames by default, therefore add
   ## the name of the file as a OpenPGP notation so at least users that look
   ## at OpenPGP notations have a chance to detect if file names have been
   ## tampered with.
   sq sign --signature-notation "file@name" "${base_name}" --signer-email "${DEBEMAIL}" --signature-file="$2" -- "$1"
   test -f "$2"
}

verify_cmd_openpgp() {
   test -f "$1"
   test -f "$2"
   test -n "${DEBEMAIL:-}"
   sq verify --signer-email "${DEBEMAIL}" --signature-file="$2" -- "$1"
}

sign_cmd_signify() {
   ## To create a key for signify-openbsd, see:
   ## derivative-maker help-steps/signing-key-create
   ## https://forums.whonix.org/t/signify-openbsd/7842
   ##
   ## Callers MUST restrict this to small files (the '.sha512sums'); signify
   ## reads the entire file into RAM.
   signify-openbsd -S -s "${signify_private_key}" -m "$1" -x "$2"
   ## Sanity test.
   test -f "$2"
}

verify_cmd_signify() {
   signify-openbsd -V -p "${signify_public_key}" -m "$1" -x "$2"
}

## OpenPGP-only sign + verify: for every published file (image, torrent,
## buildinfo). No file-size limit.
sign_and_verify() {
   sign_cmd_openpgp "${1}" "${1}.asc" || return
   verify_cmd_openpgp "${1}" "${1}.asc" || return
}

## OpenPGP + signify sign + verify: for a SMALL artifact only (never a huge
## disk image). signify reads the whole file into RAM.
sign_and_verify_signify() {
   sign_and_verify "${1}" || return
   sign_cmd_signify "${1}" "${1}.sig" || return
   verify_cmd_signify "${1}" "${1}.sig" || return
}

## Verify-only counterpart for a downstream verifier: OpenPGP ('.asc') only.
verify_signature() {
   verify_cmd_openpgp "${1}" "${1}.asc" || return
}

## Verify-only counterpart for a small artifact: OpenPGP + signify.
verify_signature_signify() {
   verify_signature "${1}" || return
   verify_cmd_signify "${1}" "${1}.sig" || return
}
