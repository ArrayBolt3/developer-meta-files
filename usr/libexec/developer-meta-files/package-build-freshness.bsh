## AI-Assisted

# shellcheck shell=bash

## Decides whether a package needs a rebuild, from a manifest of source-content
## hashes.

## style-ok: no-strict -- sourced library.

## Deterministic content hash of a package source tree. Detects an edit even
## if it did not bump debian/changelog.
dm_package_source_hash() {
   local package_source_dir="$1"
   ( cd -- "${package_source_dir}" 2>/dev/null || exit 1
     {
        ## Type, permission bits and path of every entry, sorted for
        ## determinism.
        find . -path './.git' -prune -o -printf '%y %m %p\0' | LC_ALL=C sort -z
        ## Symlink targets.
        find . -path './.git' -prune -o -type l -printf '%p -> %l\0' | LC_ALL=C sort -z
        ## Regular-file content.
        find . -path './.git' -prune -o -type f -print0 \
           | LC_ALL=C sort -z \
           | xargs -0 -r sha256sum
     } | sha256sum | cut -d ' ' -f 1
   ) || printf '%s\n' "nohash"
}

## Generate a per-codename source-hash manifest. Not shared across build slots.
dm_source_hash_manifest_path() {
   printf '%s\n' "${binary_build_folder_dist}/packages-build-status/source-hashes.${1}.txt"
}

## Manifest lines are written by dm_source_hash_record below as '<source_pkg> <hash>', one
## space, never any other whitespace.

## Look up the recorded source hash for a source package (empty if none).
dm_source_hash_lookup() {
   local manifest="$1" source_pkg="$2" line manifest_pkg
   [ -f "${manifest}" ] || return 0
   ## '|| [ -n "${line}" ]' so a final line with no trailing newline is still examined.
   while IFS= read -r line || [ -n "${line}" ]; do
      manifest_pkg="${line%% *}"
      if [ "${manifest_pkg}" = "${source_pkg}" ]; then
         printf '%s\n' "${line#* }"
         return 0
      fi
   done < "${manifest}"
   return 0
}

## Record/replace a source package's hash in the manifest (call after publishing).
dm_source_hash_record() {
   local manifest="$1" source_pkg="$2" hash="$3" tmp line manifest_pkg
   mkdir --parents -- "$(dirname -- "${manifest}")"
   tmp="$(mktemp)"
   if [ -f "${manifest}" ]; then
      while IFS= read -r line || [ -n "${line}" ]; do
         manifest_pkg="${line%% *}"
         if [ "${manifest_pkg}" = "${source_pkg}" ]; then
            continue
         fi
         ## Echo the line VERBATIM rather than reassembling it from fields, so an entry this
         ## function does not own is never reformatted.
         printf '%s\n' "${line}"
      done < "${manifest}" > "${tmp}"
   fi
   printf '%s\n' "${source_pkg} ${hash}" >> "${tmp}"
   mv -- "${tmp}" "${manifest}"
}

## Does a binary stanza's 'Architecture:' field cover a build target? Stable
## Debian policy, mirroring genmkfile's make_architecture_covers_target
## (make-helper-one.bsh): 'any'/'linux-any' and an exact '<arch>'/'linux-<arch>'
## cover; anything else does not.
dm_architecture_covers_target() {
   local architecture_field="$1" target="$2" token
   # shellcheck disable=SC2086 # architecture_field is a space-separated list that must word-split
   for token in ${architecture_field}; do
      case "${token}" in
         any | linux-any)
            return 0
            ;;
         "${target}" | "linux-${target}")
            return 0
            ;;
      esac
   done
   return 1
}

## True (0) only when the local package output still holds EVERY .deb this source
## would build for the current version and build target(s), each a REGULAR,
## NON-EMPTY file. The source-hash manifest alone cannot prove this: it is
## persistent and written independently of the pool, so a cache restore, a slot
## reset, or a concurrent build on another slot can revert/clear the built .debs
## while the manifest survives. A skip that trusted the hash alone would then ship
## whatever stale .deb remained. Content hash only: no reprepro, no version
## comparison.
##
## Per-binary .deb naming mirrors genmkfile (make-helper-one.bsh): an
## 'Architecture: all' stanza yields <pkg>_<ver>_all.deb; an arch-dependent stanza
## covering a target yields <pkg>_<ver>_<target>.deb; a stanza excluding every
## target produces no .deb and is not required.
dm_package_artifacts_present() {
   local package_source_dir distdir control version target_list
   local pkg archfield target suffix deb found_expected st
   local -a stanzas
   package_source_dir="$1"
   ## Where genmkfile deposits built .debs (variables.d/70_cowbuilder.bsh).
   distdir="${make_cowbuilder_dist_folder:-${binary_build_folder_dist}/genmkfile-packages-result}"
   [ -d "${distdir}" ] || return 1
   control="${package_source_dir}/debian/control"
   [ -f "${control}" ] || return 1
   ## .deb filenames drop the epoch (3:55.6-1 -> 55.6-1), same strip genmkfile does.
   version="$(dpkg-parsechangelog --show-field Version --file "${package_source_dir}/debian/changelog")"
   version="${version#*:}"
   ## Architectures this build targets; genmkfile builds one .deb set per entry and
   ## defaults the list to the single build target.
   target_list="${make_cross_build_platform_list:-${dist_build_target_arch:-$(dpkg --print-architecture)}}"
   ## '<pkg>\t<architecture-field>' per binary stanza; the source stanza has no Package:.
   mapfile -t stanzas < <(awk '
      /^#/ { next }
      /^Package:/ { pkg = $2; next }
      /^Architecture:/ { if (pkg != "") { sub(/^Architecture:[ \t]*/, ""); print pkg "\t" $0; pkg = "" } }
   ' "${control}")
   found_expected="false"
   for st in "${stanzas[@]}"; do
      pkg="${st%%$'\t'*}"
      archfield="${st#*$'\t'}"
      [ -n "${pkg}" ] || continue
      # shellcheck disable=SC2086 # target_list is a space-separated list that must word-split
      for target in ${target_list}; do
         if [ "${archfield}" = "all" ]; then
            suffix="all"
         elif dm_architecture_covers_target "${archfield}" "${target}"; then
            suffix="${target}"
         else
            continue
         fi
         found_expected="true"
         deb="${distdir}/${pkg}_${version}_${suffix}.deb"
         ## A regular, non-empty file -- not a dangling symlink or a 0-byte stub.
         if [ ! -f "${deb}" ] || [ ! -s "${deb}" ]; then
            return 1
         fi
         ## 'all' is arch-independent: one _all.deb covers every target.
         if [ "${suffix}" = "all" ]; then
            break
         fi
      done
   done
   ## A built package yields at least one .deb; none expected means an unexpected
   ## state -- rebuild rather than skip on nothing.
   if [ "${found_expected}" = "false" ]; then
      return 1
   fi
   return 0
}

## Decide whether a package source tree needs (re)building.
##   dm_package_needs_rebuild <package_source_dir> <apt_codename>
## Returns 0 (needs rebuild) when the source content differs from what was last
## built, when nothing was ever recorded for it, or when its built artifact is no
## longer present in the local package output. Returns 1 (skip) only when the
## recorded hash matches the current source hash AND that artifact is still there.
dm_package_needs_rebuild() {
   local package_source_dir apt_codename
   local source_pkg manifest current_hash stored_hash
   package_source_dir="$1"
   apt_codename="$2"

   source_pkg="$(dpkg-parsechangelog --show-field Source --file "${package_source_dir}/debian/changelog")"

   manifest="$(dm_source_hash_manifest_path "${apt_codename}")"
   current_hash="$(dm_package_source_hash "${package_source_dir}")"
   stored_hash="$(dm_source_hash_lookup "${manifest}" "${source_pkg}")"
   ## 'nohash' is dm_package_source_hash's failure sentinel, which forces a
   ## rebuild.
   if [ "${current_hash}" = "nohash" ] || [ -z "${stored_hash}" ] || [ "${stored_hash}" != "${current_hash}" ]; then
      true "INFO: rebuild ${source_pkg}: source content changed since last build (or first build, or hash failure)."
      return 0
   fi

   ## Source unchanged, but the manifest can be stale against the pool; only skip
   ## when the built artifact for this version actually survived.
   if ! dm_package_artifacts_present "${package_source_dir}"; then
      true "INFO: rebuild ${source_pkg}: built artifact absent from the local package output (pool reverted or cleared)."
      return 0
   fi

   true "INFO: skip ${source_pkg}: source unchanged since last build and artifact present."
   return 1
}
